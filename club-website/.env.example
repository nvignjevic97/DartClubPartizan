# Copy this file to .env and fill in real values.
# .env is gitignored - it never gets committed or pushed to GitHub.

# --- Database ---
DB_NAME=club
DB_USER=club
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-db-root-password

# --- Auth ---
# Long random string used to sign login tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret

# --- Super admin account (created automatically on first startup) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourclub.com
ADMIN_PASSWORD=change-me-admin-password

# --- Public site URL (used to build links in emails, e.g. password reset) ---
# Local dev: http://localhost:5173   Production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# --- Outgoing email (optional - leave MAIL_ENABLED=false to skip) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yourclub.com
